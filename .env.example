# Copy to .env and fill in. Never commit the real .env.
# Every *_URI/*_PASSWORD pair is read straight from the environment — no secrets in code.

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Use the exact username from YOUR instance's downloaded credentials file --
# it is not always "neo4j" (this repo's own instance used its instance ID instead).
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# bolt+ssc:// (not bolt+s://) -- Memgraph Cloud's cert is self-signed.
MEMGRAPH_URI=bolt+ssc://<instance-id>.memgraph.cloud:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=

# Use the port from your instance's Connectivity tab (not always 6379), and
# check the console for whether TLS is actually required -- this repo's own
# instance's public endpoint never completed a TLS handshake, only worked
# with FALKORDB_SSL=false.
FALKORDB_HOST=<instance-id>.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=benchmark
FALKORDB_SSL=false

ARANGO_URI=https://<instance-id>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark
